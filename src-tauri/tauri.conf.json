{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meow Debate Assistant",
  "version": "0.1.0",
  "identifier": "com.meowdebateassistant.appshell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Meow Debate Assistant",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
